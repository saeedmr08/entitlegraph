# Public development configuration only. Never commit real credentials.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Planned persistence services for the next milestone.
MONGODB_URI=mongodb://localhost:27017/entitlegraph
REDIS_URL=redis://localhost:6379

# Generate unique high-entropy values locally; these placeholders are not secrets.
ACCESS_TOKEN_SECRET=replace-with-a-local-development-secret
REFRESH_TOKEN_PEPPER=replace-with-a-different-local-secret
